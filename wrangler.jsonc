{
  // Cloudflare Workers Builds config: deploy the built static SPA (dist/) as a
  // Workers static-assets site. The Worker (worker/index.ts) routes /api/recipients
  // (the newsletter recipient manager) and serves everything else from dist/ via the
  // ASSETS binding, with an index.html fallback for client routes.
  //
  // `build.command` runs during `wrangler deploy`, so the deploy builds dist/
  // itself (install + build). That makes it self-contained even if the
  // Cloudflare project has no separate build command configured.
  "name": "tybournenewsletter",
  "compatibility_date": "2026-09-30",
  "main": "worker/index.ts",
  "build": {
    "command": "npm install && npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  }
}
